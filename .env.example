# Licensed shadcndesign Pro registry key. Keep blank here; set only in ignored .env.local.
SHADCNDESIGN_LICENSE_KEY=

# Optional when the browser should call a separately deployed Express API.
NEXT_PUBLIC_API_BASE_URL=

# Server-only managed display records. Each record includes id, token, siteId, venueName,
# preferredLines, refreshSeconds, and optional expiresAt/revokedAt. Never prefix with NEXT_PUBLIC_.
DISPLAY_CONFIGS_JSON=
